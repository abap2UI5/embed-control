// The ABAP of the examples - the RAP service and the abap2UI5 app of
// examples/fiori-elements-v2/abap - checked against abap2UI5's main, the way
// a system with abap2UI5 installed would see it (npm run abaplint, ci.yaml
// job check). abaplint does not activate RAP objects: it parses the CDS
// sources, and checks the class against the view entity it selects from;
// the service binding is beyond it.
{
  "global": {
    "files": "/examples/*/abap/**/*.*",
    "skipGeneratedGatewayClasses": true,
    "skipGeneratedPersistentClasses": true,
    "skipGeneratedProxyClasses": true
  },
  "dependencies": [
    {
      "url": "https://github.com/abap2UI5/abap2UI5",
      "folder": "/abap2ui5",
      "files": "/src/**/*.*"
    }
  ],
  // view entities are 7.55 (SAP S/4HANA 2020) - RAP with OData V2 bindings
  // starts there
  "syntax": {
    "version": "v755",
    "errorNamespace": "^(Z|Y|LCL_|TY_|LIF_)"
  },
  "rules": {
    "check_syntax": true,
    "parser_error": true,
    "cds_parser_error": true,
    "cds_legacy_view": true,
    "unknown_types": true,
    "xml_bom": true,
    "xml_consistency": true,
    "whitespace_end": true,
    "local_testclass_consistency": true,
    "wrong_abapdoc_position": true,
    "fully_type_itabs": true,
    "begin_end_names": true,
    "line_length": { "length": 255 },
    "7bit_ascii": true
  }
}
