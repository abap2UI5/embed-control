{
  "_version": "1.65.0",
  "sap.app": {
    "id": "demo.card",
    "type": "card",
    "title": "abap2UI5 app",
    "description": "Runs an abap2UI5 app - an ABAP class implementing z2ui5_if_app - in a UI Integration Card",
    "applicationVersion": {
      "version": "0.1.0"
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "sap-icon://source-code"
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {}
      }
    },
    "resourceRoots": {
      "z2ui5.embed": "./thirdparty/z2ui5/embed/"
    },
    "rootView": {
      "viewName": "demo.card.view.Card",
      "type": "XML",
      "async": true,
      "id": "card"
    }
  },
  "sap.card": {
    "type": "Component",
    "designtime": "dt/Configuration",
    "configuration": {
      "destinations": {
        "abap2UI5": {
          "name": "ABAP2UI5",
          "label": "abap2UI5 system",
          "defaultUrl": "/"
        }
      },
      "parameters": {
        "app": {
          "value": "Z2UI5_CL_UI5_APP_HI_WORLD",
          "type": "string",
          "label": "ABAP class",
          "description": "The abap2UI5 app to run - a class implementing z2ui5_if_app"
        },
        "title": {
          "value": "abap2UI5",
          "type": "string",
          "label": "Title"
        },
        "subtitle": {
          "value": "",
          "type": "string",
          "label": "Subtitle"
        },
        "service": {
          "value": "/sap/bc/z2ui5",
          "type": "string",
          "label": "abap2UI5 service",
          "description": "Path of the abap2UI5 HTTP service on the system behind the destination"
        },
        "height": {
          "value": "25rem",
          "type": "string",
          "label": "Height",
          "description": "Height of the app in the card, a CSS size"
        },
        "semanticObject": {
          "value": "",
          "type": "string",
          "label": "Header navigation: semantic object",
          "description": "Clicking the header opens the app behind this intent, e.g. the tile of the full app. Empty: the header does not navigate"
        },
        "action": {
          "value": "display",
          "type": "string",
          "label": "Header navigation: action"
        }
      }
    },
    "header": {
      "title": "{parameters>/title/value}",
      "subTitle": "{parameters>/subtitle/value}",
      "icon": {
        "src": "sap-icon://source-code"
      },
      "actions": [
        {
          "type": "Navigation",
          "enabled": "{= !!${parameters>/semanticObject/value} }",
          "parameters": {
            "ibnTarget": {
              "semanticObject": "{parameters>/semanticObject/value}",
              "action": "{parameters>/action/value}"
            }
          }
        }
      ]
    },
    "content": {
      "minHeight": "25rem"
    }
  }
}
