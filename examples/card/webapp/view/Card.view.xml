<mvc:View
    controllerName="demo.card.controller.Card"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:z2ui5="z2ui5.embed"
    displayBlock="true">
    <!-- why the app did not start - inside the card, where the admin looks -->
    <MessageStrip
        type="Error"
        showIcon="true"
        text="{embed>/error}"
        visible="{= !!${embed>/error} }"
        class="sapUiTinyMargin"/>
    <!-- the app: class, endpoint and startup parameters come from the card's
         configuration (Component.js) -->
    <z2ui5:Container
        id="container"
        app="{embed>/app}"
        endpoint="{embed>/endpoint}"
        params="{embed>/params}"
        height="{embed>/height}"
        componentFailed=".onComponentFailed"/>
</mvc:View>
