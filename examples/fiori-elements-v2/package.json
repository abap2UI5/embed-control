{
  "name": "fiori-elements-v2",
  "version": "0.1.0",
  "private": true,
  "description": "Example: a Fiori elements app for OData V2 that runs an abap2UI5 app in an object page extension, with @abap2ui5/embed-control - the RAP service it reads is in abap/",
  "license": "MIT",
  "scripts": {
    "start": "ui5 serve --open index.html",
    "start-local": "ui5 serve --config ui5-local.yaml --open index.html",
    "serve": "ui5 serve",
    "build": "ui5 build --clean-dest"
  },
  "dependencies": {
    "@abap2ui5/embed-control": "^0.1.0"
  },
  "devDependencies": {
    "@sap-ux/ui5-middleware-fe-mockserver": "^2.4.17",
    "@ui5/cli": "^4.0.70",
    "ui5-middleware-simpleproxy": "^3.9.0"
  }
}
