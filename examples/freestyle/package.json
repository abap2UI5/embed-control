{
  "name": "freestyle",
  "version": "0.1.0",
  "private": true,
  "description": "Example: a UI5 freestyle app that embeds abap2UI5 apps with @abap2ui5/embed-control",
  "license": "MIT",
  "scripts": {
    "start": "ui5 serve --open index.html",
    "start-local": "ui5 serve --config ui5-local.yaml --open index.html",
    "serve": "ui5 serve",
    "build": "ui5 build --clean-dest"
  },
  "dependencies": {
    "@abap2ui5/embed-control": "^0.1.0"
  },
  "devDependencies": {
    "@ui5/cli": "^4.0.69",
    "ui5-middleware-simpleproxy": "^3.9.0"
  }
}
