{
  "name": "embed-control-workspace",
  "private": true,
  "description": "Workspace of @abap2ui5/embed-control: the npm package (packages/) and the example apps and card that use it (examples/), with the RAP service of the OData V2 one",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "start": "npm run start --workspace examples/freestyle",
    "start:fe": "npm run start --workspace examples/fiori-elements",
    "start:card": "npm run start --workspace examples/card",
    "start:fe-v2": "npm run start --workspace examples/fiori-elements-v2",
    "start-local": "npm run start-local --workspace examples/freestyle",
    "start-local:fe": "npm run start-local --workspace examples/fiori-elements",
    "start-local:card": "npm run start-local --workspace examples/card",
    "start-local:fe-v2": "npm run start-local --workspace examples/fiori-elements-v2",
    "build": "npm run build --workspace examples/freestyle --workspace examples/fiori-elements --workspace examples/card --workspace examples/fiori-elements-v2",
    "pack:check": "npm pack --dry-run --workspace packages/embed-control",
    "consumer:check": "node scripts/consumer-check.mjs",
    "bsp": "node scripts/build-bsp.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,mjs,json}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,json}\"",
    "abaplint": "abaplint abaplint.jsonc"
  },
  "devDependencies": {
    "@abaplint/cli": "^2.120.60",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@ui5/cli": "^4.0.70",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9"
  }
}
