{
  "name": "embed-control-workspace",
  "private": true,
  "description": "Workspace of @abap2ui5/embed-control: the npm package (packages/) - its examples are in abap2UI5/samples-embed-control",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "pack:check": "npm pack --dry-run --workspace packages/embed-control",
    "consumer:check": "node scripts/consumer-check.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,mjs,json}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,json}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9"
  }
}
